# Base de datos de Payload (SQLite local)
DATABASE_URL=file:./payload.db

# Secreto para firmar cookies y tokens de sesión de Payload
# Generar un valor fuerte y aleatorio. Nunca usar este valor en producción.
PAYLOAD_SECRET=YOUR_SECRET_HERE

# URL base de la API de NestJS para sincronización de productos
API_URL=http://localhost:3003

# Secreto compartido HMAC para sincronización con NestJS
# Debe coincidir con HMAC_SYNC_SECRET en apps/api/.env
# Nunca incluir este valor en el repositorio
HMAC_SYNC_SECRET=tu_secreto_compartido_aqui
