# Puerto de la API
PORT=3000

# PostgreSQL local (Docker Compose)
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sanpablo?schema=public"

# Secreto compartido HMAC para sincronización Payload → NestJS
# Debe coincidir con HMAC_SYNC_SECRET en apps/cms/.env
# Nunca incluir este valor en el repositorio
HMAC_SYNC_SECRET=tu_secreto_compartido_aqui
