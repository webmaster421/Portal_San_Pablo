# Puerto de la API
PORT=3000

# PostgreSQL local (Docker Compose)
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Secreto compartido HMAC para sincronización Payload → NestJS
# Debe coincidir con HMAC_SYNC_SECRET en apps/cms/.env
# Nunca incluir este valor en el repositorio
HMAC_SYNC_SECRET=tu_secreto_compartido_aqui

# Clave administrativa para proteger endpoints de escritura de NestJS
# Generar un valor fuerte y aleatorio. Nunca usar este valor en producción.
ADMIN_API_KEY=tu_clave_admin_aqui_cambiar_en_produccion

# Orígenes permitidos para CORS (separados por coma)
# Ejemplo: http://localhost:3000,http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
